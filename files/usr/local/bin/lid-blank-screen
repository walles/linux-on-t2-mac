#!/bin/bash
# Lock the session, turn the screen off and suspend when the lid closes, and
# turn the screen back on when it opens. logind ignores the lid (see
# /etc/systemd/logind.conf.d/lid-ignore.conf), since the screen has to be off
# before suspending. Otherwise it stays black after the resume.
#
# Suspend hangs the machine with the Radeon powered off (amdgpu-off), so then
# this only turns the screen off. Same with an external monitor connected,
# like logind does by default.
#
# If something other than the lid wakes the machine, like plugging in the
# charger, this suspends it again if the lid is still closed. If suspending
# is refused, it retries every 30s while the lid is closed. See
# wake-with-lid-closed.md.

set -o pipefail

set_power_save() {
  # 0 = on, 3 = off
  busctl --user set-property org.gnome.Mutter.DisplayConfig \
    /org/gnome/Mutter/DisplayConfig org.gnome.Mutter.DisplayConfig \
    PowerSaveMode i "$1"
}

radeon_is_on() {
  # Its PCI vendor ID reads as ffff when amdgpu-off has cut its power. Its
  # power_state says D3hot then, same as for a sleeping card, so it can't
  # tell.
  [[ $(od -An -tx2 -N2 /sys/bus/pci/devices/0000:03:00.0/config) == " 1002" ]]
}

lid_is_closed() {
  # Asks ACPI directly. Right after a resume, UPower may not have seen the lid
  # open yet.
  grep -q closed /proc/acpi/button/lid/LID0/state
}

is_docked() {
  [[ $(busctl get-property org.freedesktop.login1 /org/freedesktop/login1 \
    org.freedesktop.login1.Manager Docked) != "b false" ]]
}

is_locked() {
  [[ $(busctl --user --timeout=5 call org.gnome.ScreenSaver \
    /org/gnome/ScreenSaver org.gnome.ScreenSaver GetActive) == "b true" ]]
}

can_suspend() { radeon_is_on && ! is_docked; }

stop_retrying() {
  # The retry loop is the only background job
  # shellcheck disable=SC2046 # One PID per word
  kill $(jobs -p) 2>/dev/null
}

suspend_or_retry() {
  stop_retrying
  systemctl suspend && return
  # Something blocks suspending, like apt installing updates after a wake.
  # Try again until it works or the lid opens.
  echo "Suspending failed, retrying every 30s while the lid is closed"
  (
    while sleep 30 && lid_is_closed && can_suspend; do
      # Something may have turned the screen on meanwhile
      set_power_save 3
      systemctl suspend && exit
    done
  ) &
}

lock_and_suspend() {
  # Locking an already locked screen never answers, so don't
  if ! is_locked; then
    busctl --user --timeout=5 call org.gnome.ScreenSaver \
      /org/gnome/ScreenSaver org.gnome.ScreenSaver Lock
    # Let the lock screen come up first, it turns the screen on
    sleep 1
  fi
  # The lid may have opened again meanwhile
  lid_is_closed || return
  set_power_save 3
  if can_suspend; then
    suspend_or_retry
  fi
}

monitor() {
  gdbus monitor --system --dest org.freedesktop.UPower \
    --object-path /org/freedesktop/UPower &
  gdbus monitor --system --dest org.freedesktop.login1 \
    --object-path /org/freedesktop/login1 &
  # If either one stops, stop the other one too, so systemd restarts us
  wait -n
  # shellcheck disable=SC2046 # One PID per word
  kill $(jobs -p) 2>/dev/null
  return 1
}

last_resuspend=-60
monitor |
  while read -r line; do
    case "$line" in
    *"'LidIsClosed': <true>"*)
      lock_and_suspend
      ;;
    *"'LidIsClosed': <false>"*)
      stop_retrying
      set_power_save 0
      ;;
    *".PrepareForSleep (false,)"*)
      # Just resumed
      if lid_is_closed; then
        # Don't loop if suspends keep failing or waking right back up.
        # SECONDS follows the wall clock, so time asleep counts.
        if ((SECONDS - last_resuspend < 60)); then
          echo "Woke up with the lid closed again within a minute, staying awake"
        else
          echo "Woke up with the lid closed, suspending again"
          last_resuspend=$SECONDS
          lock_and_suspend
        fi
      fi
      ;;
    esac
  done
