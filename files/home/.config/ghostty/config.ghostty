# 1 GB per pane, allocated lazily. Unlimited is not supported yet. There is no
# dedicated ticket for unlimited scrollback, but the closing comment here says
# it's a "maybe" and would need architectural work:
# https://github.com/ghostty-org/ghostty/discussions/8593
scrollback-limit = 1000000000
font-size = 11

# Cmd-Option-Left/Right switches tabs, like in Firefox and VS Code, see
# keyboard-mappings.md. Replaces moving between splits left / right.
keybind = ctrl+alt+arrow_left=previous_tab
keybind = ctrl+alt+arrow_right=next_tab
