# Keep the Titan Ridge Thunderbolt xHCI controllers (USB-C ports) powered.
# Apple firmware lacks the ACPI device links ("device links to tunneled native
# ports are missing!"), so a runtime-suspended controller never wakes on plug-in.
ACTION=="add|bind", SUBSYSTEM=="pci", ATTR{vendor}=="0x8086", ATTR{device}=="0x15ec", ATTR{power/control}="on"
